# Xiaomi Pad 6S Pro (sheng), stock HyperOS OS3.0.303.0.WNXCNXM.
export DEVICE=sheng
export KBUILD_BUILD_USER=peiyuesheng KBUILD_BUILD_HOST=MiFans KBUILD_BUILD_VERSION=1
# Release requested for r75; the timeout value is used only when explicitly building debug.
export SHENG_BUILD_MODE="${SHENG_BUILD_MODE:-release}"
export SHENG_TEST_TIMEOUT=300
