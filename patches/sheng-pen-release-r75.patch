+{
+	int rc;
+	size_t i;
+
+	if (!bcdev->sheng_has_pen)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(sheng_pen_attrs); i++) {
+		rc = class_create_file(&bcdev->battery_class, sheng_pen_attrs[i]);
+		if (rc)
+			goto remove;
+	}
+	return 0;
+remove:
+	while (i)
+		class_remove_file(&bcdev->battery_class, sheng_pen_attrs[--i]);
