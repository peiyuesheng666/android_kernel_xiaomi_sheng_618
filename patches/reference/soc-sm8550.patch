+static void gcc_kalama_fixup_kalamav2(struct regmap *regmap)
+{
+	gcc_sdcc2_apps_clk_src.freq_tbl = ftbl_gcc_sdcc2_apps_clk_src_kalama_v2;
+	gcc_sdcc2_apps_clk_src.clkr.vdd_data.rate_max[VDD_LOW_L1] = 202000000;
+}
+
+static int gcc_kalama_fixup(struct platform_device *pdev, struct regmap *regmap)
+{
+	const char *compat = NULL;
+	int compatlen = 0;
+
+	compat = of_get_property(pdev->dev.of_node, "compatible", &compatlen);
+	if (!compat || compatlen <= 0)
+		return -EINVAL;
+
+	if (!strcmp(compat, "qcom,kalama-gcc-v2"))
+		gcc_kalama_fixup_kalamav2(regmap);
+
+	return 0;
+}
+
+static int gcc_kalama_probe(struct platform_device *pdev)
+{
+	struct regmap *regmap;
+	int ret;
+
+	regmap = qcom_cc_map(pdev, &gcc_kalama_desc);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+
+	ret = gcc_kalama_fixup(pdev, regmap);
+	if (ret)
+		return ret;
+
+	ret = qcom_cc_register_rcg_dfs(regmap, gcc_dfs_clocks,
+				       ARRAY_SIZE(gcc_dfs_clocks));
+	if (ret)
+		return ret;
+
+	/* FORCE_MEM_CORE_ON for ufs phy ice core clocks */
+	regmap_update_bits(regmap, gcc_ufs_phy_ice_core_clk.halt_reg,
+			   BIT(14), BIT(14));
+
+	/* Clear GDSC_SLEEP_ENA_VOTE to stop votes being auto-removed in sleep. */
+	regmap_write(regmap, 0x52024, 0x0);
+
+	ret = qcom_cc_really_probe(&pdev->dev, &gcc_kalama_desc, regmap);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register GCC clocks\n");
+		return ret;
+	}
+
+	dev_info(&pdev->dev, "Registered GCC clocks\n");
+
+	return ret;
+}
+
+static void gcc_kalama_sync_state(struct device *dev)
+{
+	qcom_cc_sync_state(dev, &gcc_kalama_desc);
+}
+
+static struct platform_driver gcc_kalama_driver = {
+	.probe = gcc_kalama_probe,
+	.driver = {
+		.name = "gcc-kalama",
+		.of_match_table = gcc_kalama_match_table,
+		.sync_state = gcc_kalama_sync_state,
+	},
+};
+
+static int __init gcc_kalama_init(void)
+{
+	return platform_driver_register(&gcc_kalama_driver);
+}
+subsys_initcall(gcc_kalama_init);
+
+static void __exit gcc_kalama_exit(void)
+{
+	platform_driver_unregister(&gcc_kalama_driver);
+}
+module_exit(gcc_kalama_exit);
+
+MODULE_DESCRIPTION("QTI GCC KALAMA Driver");
+MODULE_LICENSE("GPL v2");
