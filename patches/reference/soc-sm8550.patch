+/* k618: num-hc-interrupters for the USB audio offload's interrupter (see k618_kalama.py) */
+static void k618_dwc3_hc_interrupters(struct device *dev, struct device_node *dwc3_node)
+{
+	struct device_node *qmi;
+	struct property *prop;
+	__be16 *val;
+	u32 intr = 0;
+
+	if (of_property_present(dwc3_node, "num-hc-interrupters"))
+		return;
+	qmi = of_find_compatible_node(NULL, NULL, "qcom,usb-audio-qmi-dev");
+	if (!qmi)
+		return;
+	of_property_read_u32(qmi, "qcom,usb-audio-intr-num", &intr);
+	of_node_put(qmi);
+	if (!intr)
+		return;
+	prop = kzalloc(sizeof(*prop) + sizeof(*val), GFP_KERNEL);
+	if (!prop)
+		return;
+	val = (__be16 *)(prop + 1);
+	*val = cpu_to_be16(intr + 1);
+	prop->name = "num-hc-interrupters";
+	prop->length = sizeof(*val);
+	prop->value = val;
+	if (of_add_property(dwc3_node, prop)) {
+		kfree(prop);
+		return;
+	}
+	dev_info(dev, "k618: num-hc-interrupters %u (USB audio offload uses interrupter %u)\n",
+		 intr + 1, intr);
+}
