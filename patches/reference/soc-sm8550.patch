index 9691c20390..60d21a8f0f 100644
--- a/drivers/usb/typec/ucsi/ucsi_qti_glink.c
+++ b/drivers/usb/typec/ucsi/ucsi_qti_glink.c
@@ -497,12 +497,29 @@ static int ucsi_qti_read_message_in(struct ucsi *ucsi, void *val,
 	return ucsi_qti_read(udev, UCSI_MESSAGE_IN, val, val_len);
 }
 
+/*
+ * 6.18's UCSI core leaves reading CCI and MESSAGE_IN after a blocking command to .sync_control
+ * (as ucsi_sync_control_common() does for the drivers that wait on the core's completion; this
+ * one waits for the PMIC's acknowledgement of the write)
+ */
+static int ucsi_qti_sync_control_618(struct ucsi *ucsi, u64 command, u32 *cci,
+				     void *data, size_t size)
+{
+	int ret = ucsi_qti_sync_control(ucsi, command);
+
+	if (!ret && cci)
+		ret = ucsi_qti_read_cci(ucsi, cci);
+	if (!ret && data && cci && (*cci & UCSI_CCI_COMMAND_COMPLETE))
+		ret = ucsi_qti_read_message_in(ucsi, data, size);
+	return ret;
+}
+
 static const struct ucsi_operations ucsi_qti_ops = {
 	.read_version = ucsi_qti_read_version,
 	.read_cci = ucsi_qti_read_cci,
 	.poll_cci = ucsi_qti_read_cci,
 	.read_message_in = ucsi_qti_read_message_in,
-	.sync_control = ucsi_qti_sync_control,
+	.sync_control = ucsi_qti_sync_control_618,
 	.async_control = ucsi_qti_async_control,
 };
 
