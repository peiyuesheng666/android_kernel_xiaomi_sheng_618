+/*
+ * A copy of the log on disk at once, the way the NFC probe marks do it: a reset within a few
+ * hundred milliseconds of this point would otherwise lose exactly the lines that say why (the
+ * probe's own copy runs every 250 ms).
+ */
+unsigned int k618_probe_flush(unsigned int spin_ms);	/* the test probe's, when it is loaded */
+
+static void k618_ice_flush(void)
+{
+	unsigned int (*f)(unsigned int) = symbol_get(k618_probe_flush);
+
+	if (f) {
+		f(200);
+		symbol_put(k618_probe_flush);
+	}
