+	rc = write_property_id(bcdev, &bcdev->psy_list[PSY_TYPE_XM],
+				XM_PROP_WLSCHARGE_CONTROL_LIMIT, val);
+	if (rc < 0)
+		return rc;
+
+	bcdev->curr_wlsthermal_level = val;
+
+	return count;
+}
