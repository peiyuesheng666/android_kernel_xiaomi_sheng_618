+/*
+ * k618: the phone's own 5.15 driver gives the modem its DSM memory once, at probe, before the modem
+ * is ever started: the no-map region that mpss_dsm_mem_reg points at goes from HLOS to the modem's
+ * MSA VM, read-write (setup_mpss_dsm_mem, needs_dsm_mem_setup). This release's driver has no such
+ * step. Without it the modem crashes about 34 ms after it starts (6.12), or the kernel log stops
+ * about 0.7 s after the modem's firmware is loaded (6.18).
+ */
+static bool k618_dsm_done;
+
+static int k618_mpss_dsm_setup(struct platform_device *pdev)
+{
+	struct qcom_scm_vmperm dst = { .vmid = QCOM_SCM_VMID_MSS_MSA, .perm = QCOM_SCM_PERM_RW };
+	u64 src = BIT(QCOM_SCM_VMID_HLOS);
+	struct device_node *node;
+	struct resource res;
+	int ret;
+
+	if (k618_dsm_done)
+		return 0;
+	node = of_parse_phandle(pdev->dev.of_node, "mpss_dsm_mem_reg", 0);
+	if (!node) {
+		dev_err(&pdev->dev, "mpss dsm mem region is missing\n");
+		return -EINVAL;
+	}
+	ret = of_address_to_resource(node, 0, &res);
+	of_node_put(node);
+	if (ret) {
+		dev_err(&pdev->dev, "address to resource failed for mpss dsm mem\n");
+		return ret;
+	}
+	ret = qcom_scm_assign_mem(res.start, resource_size(&res), &src, &dst, 1);
+	if (ret) {
+		dev_err(&pdev->dev, "hyp assign for mpss dsm mem failed: %d\n", ret);
+		return ret;
+	}
+	dev_info(&pdev->dev, "k618: mpss dsm mem %pR given to the modem\n", &res);
+	k618_dsm_done = true;
+	return 0;
