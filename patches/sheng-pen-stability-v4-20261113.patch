+MODULE_PARM_DESC(sheng_m80p_contact_hold_ms, "N81A M80p contact-gap hold, 0 disables, maximum 32 ms");
+
+/* M80p type-29 captures have periodic zero-contact packets during a stroke.
+ * Use the same verified packet layout with an independent, shorter deadline.
+ * Hand-data fragment numbers are not contact bits. Repaired packets never
+ * renew the deadline. A zero-contact packet is held only within hold_ms of
+ * the last real contact. Serialize notification resets with IRQs.
+ */
+static void sheng_m80p_contact_reset(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sheng_m80p_contact_lock, flags);
+	memset(&sheng_m80p_contact_state, 0, sizeof(sheng_m80p_contact_state));
+	spin_unlock_irqrestore(&sheng_m80p_contact_lock, flags);
+}
+
+static void sheng_m80p_filter_frame(unsigned char *data, unsigned int size,
+		unsigned long long now_ns)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sheng_m80p_contact_lock, flags);
+	sheng_pen_filter_contact(&sheng_m80p_contact_state, data, size, now_ns,
+		READ_ONCE(sheng_m80p_contact_hold_ms));
+	spin_unlock_irqrestore(&sheng_m80p_contact_lock, flags);
+}
