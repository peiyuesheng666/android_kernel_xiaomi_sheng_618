// SPDX-License-Identifier: Apache-2.0
android_app {
    name: "ShengDolby",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    required: ["privapp-permissions-org.lineageos.sheng.dolby.xml"],
    overrides: ["AudioFX", "MusicFX"],
}

prebuilt_etc {
    name: "privapp-permissions-org.lineageos.sheng.dolby.xml",
    src: "privapp-permissions-org.lineageos.sheng.dolby.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
