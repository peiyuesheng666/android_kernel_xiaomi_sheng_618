--- a/vendor/qcom/opensource/display-drivers/msm/sde/sde_connector.c
+++ b/vendor/qcom/opensource/display-drivers/msm/sde/sde_connector.c
@@ -564,6 +564,22 @@
 	props.max_brightness = bl_config->brightness_max_level;
 #ifndef OPLUS_FEATURE_DISPLAY
 	props.brightness = bl_config->brightness_max_level;
+	/* MiCode sheng and LOS use the DT initial level, not maximum brightness.
+	 * Keep this tablet adaptation local to the N81A external-backlight panel. */
+	{
+		u64 panel_id;
+		u32 initial;
+
+		if (display->panel->bl_config.type == DSI_BACKLIGHT_EXTERNAL &&
+		    !of_property_read_u64(display->panel->panel_of_node,
+			"mi,panel-id", &panel_id) && panel_id == 0x4e38316150360200ULL &&
+		    !of_property_read_u32(display->panel->panel_of_node,
+			"qcom,mdss-brightness-init-level", &initial)) {
+			props.brightness = min_t(u32, initial, props.max_brightness);
+			SDE_INFO("sheng initial backlight=%u max=%u\n",
+				props.brightness, props.max_brightness);
+		}
+	}
 #else /* OPLUS_FEATURE_DISPLAY */
 	if (oplus_display_ops.backlight_setup_pre) {
 		oplus_display_ops.backlight_setup_pre(&props, display);
