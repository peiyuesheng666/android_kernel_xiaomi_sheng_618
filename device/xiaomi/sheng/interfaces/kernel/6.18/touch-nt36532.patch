-extern ssize_t mi_dsi_panel_lockdown_info_read(unsigned char *plockdowninfo);
+/* N81A's bootloader publishes these bytes in SMEM item 500 (MiCode parser). */
+#include <linux/soc/qcom/smem.h>
+static ssize_t mi_dsi_panel_lockdown_info_read(unsigned char *info)
+{
+	size_t size;
+	const void *data;
+
+	if (!info)
+		return -EINVAL;
+	data = qcom_smem_get(QCOM_SMEM_HOST_ANY, 500, &size);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	if (size < 8)
+		return -EINVAL;
+	memcpy(info, data, 8);
+	return info[0];
+}
