+/* sheng's PHY ref_clk_src is XO_PAD, not a parent of the GCC pipe mux.
+ * Keep that reference vote, but select the GCC mux's own bi_tcxo on suspend.
+ * Parent index 1 belongs to the fixed gcc-kalama parent_data_13, not a
+ * hardware selector value. Do not alter other boards or clock topologies.
+ */
+static int sheng_ssphy_qmp_get_pipe_xo(struct msm_ssphy_qmp *phy,
+		struct device *dev)
+{
+	struct clk_hw *mux, *xo;
+
+	phy->pipe_clk_xo = phy->ref_clk_src;
+	if (!of_root || of_property_match_string(of_root, "model",
+			"Qualcomm Technologies, Inc. 8550 sheng") < 0 ||
+			!phy->pipe_clk_mux || !phy->ref_clk_src)
+		return 0;
+
+	mux = __clk_get_hw(phy->pipe_clk_mux);
+	if (!mux || strcmp(clk_hw_get_name(mux),
+			"gcc_usb3_prim_phy_pipe_clk_src"))
+		return 0;
+	if (clk_has_parent(phy->pipe_clk_mux, phy->ref_clk_src))
+		return 0;
+	if (clk_hw_get_num_parents(mux) != 2)
+		return dev_err_probe(dev, -EINVAL, "unexpected sheng pipe mux parents\n");
+
+	xo = clk_hw_get_parent_by_index(mux, 1);
+	if (!xo)
+		return dev_err_probe(dev, -EPROBE_DEFER, "GCC pipe XO parent not ready\n");
+	phy->pipe_clk_xo = devm_clk_hw_get_clk(dev, xo, "pipe_clk_xo");
+	if (IS_ERR(phy->pipe_clk_xo))
+		return dev_err_probe(dev, PTR_ERR(phy->pipe_clk_xo),
+				"failed to get GCC pipe XO parent\n");
+	dev_info(dev, "sheng pipe suspend parent: %s\n", clk_hw_get_name(xo));
+	return 0;
+}
+
 static int msm_ssphy_qmp_get_clks(struct msm_ssphy_qmp *phy, struct device *dev)
 {
