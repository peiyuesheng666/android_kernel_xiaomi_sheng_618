<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.sheng.displaydefaults" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <application android:label="Sheng display defaults" android:allowBackup="false"
        android:directBootAware="true" android:hasCode="true">
        <receiver android:name=".DefaultRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_INITIALIZE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
