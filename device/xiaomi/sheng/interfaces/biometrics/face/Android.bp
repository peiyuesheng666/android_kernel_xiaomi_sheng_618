// Original sheng executables; use the public frozen V2 interface modules.
cc_prebuilt_binary {
    name: "sheng-face-aidl-service",
    stem: "android.hardware.biometrics.face-aidl-service",
    device_specific: true,
    compile_multilib: "64",
    srcs: ["bin/hw/android.hardware.biometrics.face-aidl-service"],
    relative_install_path: "hw",
    init_rc: ["etc/init/android.hardware.biometrics.face-aidl-service.rc"],
    vintf_fragments: ["etc/vintf/manifest/face-default.xml"],
    shared_libs: [
        "libutils",
        "libbase",
        "libcutils",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "android.hardware.biometrics.face-V2-ndk",
        "android.hardware.biometrics.common-V2-ndk",
        "vendor.xiaomi.hardware.miface@1.0",
        "libc++",
    ],
    stl: "none",
    strip: {
        none: true,
    },
}

cc_prebuilt_binary {
    name: "sheng-miface-service",
    stem: "mifaced@1.0",
    device_specific: true,
    compile_multilib: "64",
    srcs: ["bin/mifaced@1.0"],
    init_rc: ["etc/init/vendor.xiaomi.hardware.miface@1.0-service.rc"],
    vintf_fragments: ["etc/vintf/manifest/manifest_vendor.xiaomi.hardware.miface.xml"],
    shared_libs: [
        "libui",
        "liblog",
        "libion",
        "libfmq",
        "libbase",
        "libcutils",
        "libutils",
        "libQSEEComAPI",
        "libhidlbase",
        "libsheng_hidltransport_link",
        "libcamera2ndk_vendor",
        "libcamera_metadata",
        "libmediandk",
        "libnativewindow",
        "libhardware",
        "libdmabufheap",
        "libmisight",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.bufferqueue@1.0",
        "vendor.xiaomi.hardware.miface@1.0",
        "libmiface",
        "libc++",
    ],
    stl: "none",
    strip: {
        none: true,
    },
}
