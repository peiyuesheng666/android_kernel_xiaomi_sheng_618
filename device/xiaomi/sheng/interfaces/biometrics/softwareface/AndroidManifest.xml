<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.sheng.facelab" android:versionCode="2" android:versionName="0.2">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />
    <application android:label="人脸录入测试" android:allowBackup="false"
        android:fullBackupContent="false" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".FaceLabActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
