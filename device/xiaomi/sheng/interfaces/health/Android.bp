// SPDX-License-Identifier: BSD-3-Clause-Clear
// Retain the QTI installed identities while owning the sheng configuration.
cc_binary {
    name: "android.hardware.health-service.sheng",
    stem: "android.hardware.health-service.qti",
    relative_install_path: "hw",
    vendor: true,
    defaults: ["libhealth_aidl_impl_user"],
    static_libs: ["libhealth_aidl_impl"],
    srcs: ["main.cpp"],
    include_dirs: [
        "system/core/healthd",
        "system/core/healthd/include",
        "system/core/healthd/include_charger",
    ],
    cflags: ["-Wall", "-Werror"],
    init_rc: ["android.hardware.health-service.qti.rc"],
    vintf_fragments: ["android.hardware.health-service.qti.xml"],
    overrides: ["android.hardware.health-service.qti", "charger"],
}
