# SPDX-License-Identifier: Apache-2.0
# Preserve the standard service, user, output and APEX ordering. Select the
# board-generated fragment with one extra form-factor compatibility jar.
service derive_classpath /apex/com.android.sdkext/bin/derive_classpath --bootclasspath-fragment=/system_ext/etc/sheng/bootclasspath.pb
    override
    user system
    group system reserved_disk
    oneshot
    disabled
