// SPDX-License-Identifier: Apache-2.0
cc_defaults {
    name: "sheng-dolby-codec2-service-defaults",
    vendor: true,
    installable: false,
    compile_multilib: "64",
    relative_install_path: "hw",
    defaults: ["libcodec2-hidl-defaults@1.0"],
    srcs: ["service.cpp"],
    shared_libs: ["libbinder", "libhidlbase", "liblog", "libutils"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "sheng-dolbycodec2",
    stem: "dolbycodec2",
    defaults: ["sheng-dolby-codec2-service-defaults"],
    shared_libs: ["c2.dolby.store"],
    cflags: ["-DSHENG_CODEC2_INSTANCE=\"dolby\""],
}

cc_binary {
    name: "sheng-vendor.dolby.media.c2@1.0-service",
    stem: "vendor.dolby.media.c2@1.0-service",
    defaults: ["sheng-dolby-codec2-service-defaults"],
    shared_libs: ["libcodec2_store_dolby"],
    cflags: ["-DSHENG_CODEC2_INSTANCE=\"default1\""],
}

// Stock video handlers use the pre-delivery-status AHandler layout. Keep the
// generated vendor installer identities and isolate only their foundation ABI.
filegroup {
    name: "sheng_dolby_video_decoder_legacy_handler_input",
    srcs: ["video/c2.dolby.hevc.dec.so"],
}

filegroup {
    name: "sheng_dolby_video_secure_decoder_legacy_handler_input",
    srcs: ["video/c2.dolby.hevc.sec.dec.so"],
}
