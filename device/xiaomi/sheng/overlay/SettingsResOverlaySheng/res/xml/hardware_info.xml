<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/prv/res/com.android.settings"
    android:title="@*com.android.settings:string/model_info"
    settings:keywords="@*com.android.settings:string/keywords_model_and_hardware">

    <!-- Keep the marketed name and numeric hardware model visible separately. -->
    <Preference
        android:key="sheng_marketname"
        android:title="Model name"
        android:summary="Xiaomi Pad 6S Pro 12.4"
        android:selectable="false"
        settings:enableCopying="true"/>

    <!-- Model -->
    <Preference
        android:key="hardware_info_device_model"
        android:title="Model number"
        android:summary="@*com.android.settings:string/summary_placeholder"
        android:selectable="false"
        settings:controller="com.android.settings.deviceinfo.hardwareinfo.DeviceModelPreferenceController"
        settings:enableCopying="true"/>

    <Preference
        android:key="sheng_codename"
        android:title="Device codename"
        android:summary="sheng"
        android:selectable="false"
        settings:enableCopying="true"/>

    <!-- SerialNumber -->
    <Preference
        android:key="hardware_info_device_serial"
        android:title="@*com.android.settings:string/status_serial_number"
        android:summary="@*com.android.settings:string/summary_placeholder"
        android:selectable="false"
        settings:controller="com.android.settings.deviceinfo.hardwareinfo.SerialNumberPreferenceController"
        settings:enableCopying="true"/>

    <!-- Hardware revision -->
    <Preference
        android:key="hardware_info_device_revision"
        android:title="@*com.android.settings:string/hardware_revision"
        android:summary="@*com.android.settings:string/summary_placeholder"
        android:selectable="false"
        settings:controller="com.android.settings.deviceinfo.hardwareinfo.HardwareRevisionPreferenceController"
        settings:enableCopying="true"/>

    <!-- Manufactured year -->
    <Preference
        android:key="hardware_info_manufactured_year"
        android:title="@*com.android.settings:string/manufactured_year"
        android:summary="@*com.android.settings:string/summary_placeholder"
        android:selectable="false"
        settings:controller="com.android.settings.deviceinfo.hardwareinfo.ManufacturedYearPreferenceController"
        settings:enableCopying="true"/>

</PreferenceScreen>
