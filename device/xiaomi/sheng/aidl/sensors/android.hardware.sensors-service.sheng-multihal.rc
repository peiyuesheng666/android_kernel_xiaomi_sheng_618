service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.sheng-multihal
    override
    interface aidl android.hardware.sensors.ISensors/default
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    socket audio_us_socket_1 seqpacket 0666 system system
